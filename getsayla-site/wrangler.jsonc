// getsayla.com (conta Cloudflare getsayla). Publicar: node fetch-site.mjs && npx wrangler@4 deploy
// ./public = os ficheiros do site; worker.js = lista de espera, demo, Pro e vídeos.
{
  "name": "falling-snowflake-4605",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "WAITLIST", "id": "459c6ffade7d4954a7cf4816aecdaaa5" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/assets/*.mp4"]
  }
}
