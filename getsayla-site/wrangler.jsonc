// getsayla.com (conta Cloudflare getsayla). Publicar: npx wrangler@4 deploy
// Os ficheiros do site (index.html, site.css, imagens...) ficam os que já estão no Cloudflare (keep_assets):
// este deploy só troca o worker e diz que "/", "/index.html" e "/showcase.js" passam pelo worker.
{
  "name": "falling-snowflake-4605",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "WAITLIST", "id": "459c6ffade7d4954a7cf4816aecdaaa5" }],
  "unsafe": {
    "bindings": [{ "name": "ASSETS", "type": "assets" }],
    "metadata": {
      "keep_assets": true,
      "assets": {
        "config": {
          "html_handling": "auto-trailing-slash",
          "not_found_handling": "404-page",
          "run_worker_first": ["/api/*", "/assets/*.mp4", "/", "/index.html", "/showcase.js"]
        }
      }
    }
  }
}
